# Copy to .env at the repo root. Every value has a local-dev default, so the app
# also runs without a .env file (see README "Assumptions").

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://cparena:cparena@localhost:5432/cparena

# Auth.js secret — generate with: npx auth secret
# Required in production: the web app refuses to start if it's empty or missing.
# In dev a fixed insecure fallback is used if unset.
AUTH_SECRET=
# Public URL of the web app (needed behind proxies / in production)
AUTH_URL=http://localhost:3000

# Google sign-in (optional locally). Create an OAuth client at
# https://console.cloud.google.com/apis/credentials with redirect URI
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Dev login: lets you sign in as any seeded member without OAuth.
# Defaults to on when NODE_ENV != production. NEVER enable in production.
AUTH_DEV_LOGIN=true

# Honest User-Agent contact for outbound requests to LeetCode/Codeforces/CodeChef
CONTACT_EMAIL=admin@example.com

# Optional: clist.by API v4 key (format "username:apikey") — contest-calendar fallback. Not used yet (TODO).
CLIST_API_KEY=

# Worker
WORKER_FULL_SYNC_HOURS=6
WORKER_POLL_SECONDS=5
